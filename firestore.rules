rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Existing rules (unchanged) ────────────────────────────────────────────

    match /users/{uid}/saathiMessages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/memories/{memoryId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /sos_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read:   if request.auth != null;
    }

    // ── User profiles ─────────────────────────────────────────────────────────
    // Authenticated users can read any profile (needed for caretaker lookups)
    // Only owner can write their own profile
    match /users/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // ── Caretaker Messages ────────────────────────────────────────────────────
    // Schema: { toUserId, fromName, fromUid, text, type, timestamp, read }
    // Caretaker (web dashboard) creates → elder reads + marks read
    match /caretakerMessages/{messageId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
                          && resource.data.toUserId == request.auth.uid;
    }

    // ── Caretaker Profiles ────────────────────────────────────────────────────
    // Schema: { name, specialization, phone, elderUserId, elderName, joinedAt }
    // Public read (elder looks up their caretaker), caretaker writes own profile
    match /caretakerProfiles/{caretakerId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == caretakerId;
    }
  }
}
