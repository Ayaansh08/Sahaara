rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Emergency WhatsApp contacts
    // NOTE: Storing the CallMeBot API key in Firestore is for the hackathon demo only.
    match /users/{uid}/emergencyContacts/{contactId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/saathiMessages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /users/{uid}/memories/{memoryId} {
      allow read, write, delete: if request.auth != null;
    }

    match /sos_alerts/{alertId} {
      allow create, read, update: if request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null;
    }

    match /caretakerMessages/{messageId} {
      allow create, read, update: if request.auth != null;
    }

    match /elderToCaretakerMessages/{messageId} {
      allow create, read, update: if request.auth != null;
    }

    match /caretakerProfiles/{caretakerId} {
      allow read, write: if request.auth != null;
    }

    match /waves/{waveId} {
      allow read, write: if request.auth != null;
    }
  }
}
