rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User-specific SAATHI conversation messages
    match /users/{uid}/saathiMessages/{messageId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    
    // User-specific memories (Yaadein)
    match /users/{uid}/memories/{memoryId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == uid;
    }
    
    // User-specific SOS emergency alerts
    match /sos_alerts/{alertId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }
  }
}
