GROQ_API_KEY=your_groq_api_key
SARVAM_API_KEY=your_sarvam_api_key
TTS_PROVIDER=sarvam
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=0.9
SARVAM_TTS_TEMPERATURE=0.7
GROQ_MODEL=llama-3.1-8b-instant
PORT=3000
FIREBASE_PROJECT_ID=sahaara-93ecc

# ─── WhatsApp Provider Selection ──────────────────────────────────────────
# Active WhatsApp provider: 'whatsgateway' (self-hosted REST API) or 'twilio'
WHATSAPP_PROVIDER=whatsgateway

# ─── WhatsGateway Self-Hosted WhatsApp API Configuration ─────────────────────
# Running independently via Docker Compose on the host machine
# For local development, Express backend connects to host port 8080:
WHATSAPP_GATEWAY_URL=http://127.0.0.1:8080
# API key generated in WhatsGateway Dashboard (/api-keys)
WHATSAPP_GATEWAY_API_KEY=your_whatsgateway_api_key_here
# Timeout in milliseconds for outbound API requests
WHATSAPP_GATEWAY_TIMEOUT_MS=15000
# Webhook HMAC secret configured in WhatsGateway Dashboard (/webhooks)
WHATSAPP_GATEWAY_WEBHOOK_SECRET=your_whatsgateway_webhook_secret_here
# Optional public HTTPS URL for receiving delivery status webhooks from WhatsGateway
WHATSAPP_GATEWAY_STATUS_CALLBACK_URL=

# ─── Vitals Demo Mode WhatsApp Dispatch Configuration ───────────────────────
# When true, automatic Vitals demo events will dispatch real WhatsApp messages
# strictly to the test recipients specified in DEMO_TEST_RECIPIENTS.
# When false (default), demo mode is fully isolated (zero external messages sent).
DEMO_ALLOW_REAL_WHATSAPP_SEND=false

# Comma-separated list of test recipient phone numbers with country code (e.g. 919876543210,919876543211)
# Demo messages will ONLY be sent to these test recipients, NEVER to real emergency contacts.
DEMO_TEST_RECIPIENTS=

# ─── Meta WhatsApp Business Cloud API Configuration ─────────────────────────
# Obtain these from: https://developers.facebook.com/ > My Apps > WhatsApp > API Setup
# 1. WHATSAPP_ACCESS_TOKEN: System User Access Token or Temporary 24-hr Token
#    Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token

# 2. WHATSAPP_PHONE_NUMBER_ID: Found under "From: Phone number ID" on the API Setup page
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# 3. Graph API Version (defaults to v22.0)
WHATSAPP_API_VERSION=v22.0

# 4. WhatsApp Utility Template Configuration (REQUIRED for emergency alerts)
# An approved UTILITY template is required by Meta to initiate alerts outside the 24-hr window.
# Template parameters expected:
# {{1}} = User Name
# {{2}} = Emergency Message / Alert Reason
# {{3}} = Location / Address
# {{4}} = Google Maps Link
# {{5}} = Timestamp
WHATSAPP_TEMPLATE_NAME=sahaara_emergency_alert
WHATSAPP_TEMPLATE_LANG=en_US

# ─── Twilio WhatsApp Configuration ──────────────────────────────────────────
# Required for WhatsApp messaging via Twilio (Sandbox or Production)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_API_KEY=your_twilio_api_key_sid
TWILIO_API_SECRET=your_twilio_api_key_secret
TWILIO_AUTH_TOKEN=your_twilio_auth_token

TWILIO_WHATSAPP_FROM=whatsapp:+17372508034
TWILIO_WHATSAPP_MODE=sandbox
TWILIO_WHATSAPP_CONTENT_SID=HXfe5ab5f00277942d4d4200328b4d403c
TWILIO_STATUS_CALLBACK_URL=
