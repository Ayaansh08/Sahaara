GROQ_API_KEY=your_groq_api_key
SARVAM_API_KEY=your_sarvam_api_key
TTS_PROVIDER=sarvam
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_PACE=0.9
SARVAM_TTS_TEMPERATURE=0.7
GROQ_MODEL=llama-3.1-8b-instant
PORT=3000

# ─── Meta WhatsApp Business Cloud API Configuration ─────────────────────────
# Obtain these from: https://developers.facebook.com/ > My Apps > WhatsApp > API Setup
# 1. WHATSAPP_ACCESS_TOKEN: System User Access Token or Temporary 24-hr Token
#    Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token

# 2. WHATSAPP_PHONE_NUMBER_ID: Found under "From: Phone number ID" on the API Setup page
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# 3. Graph API Version (defaults to v22.0)
WHATSAPP_API_VERSION=v22.0

# 4. WhatsApp Utility Template Configuration (REQUIRED for emergency alerts)
# An approved UTILITY template is required by Meta to initiate alerts outside the 24-hr window.
# Template parameters expected:
# {{1}} = User Name
# {{2}} = Emergency Message / Alert Reason
# {{3}} = Location / Address
# {{4}} = Google Maps Link
# {{5}} = Timestamp
WHATSAPP_TEMPLATE_NAME=sahaara_emergency_alert
WHATSAPP_TEMPLATE_LANG=en_US
